# Lou — environment example. Copy to .env for local runs.
# Never commit .env. PAYPAL_CLIENT_SECRET and LLM_API_KEY are secrets.

# true  = always simulate the LLM and PayPal (tests and local dev without keys)
# false = never simulate. Chat returns an error until both secrets are set.
# unset = simulate only the side that is missing a key, and say so in the banner
# Set to false to skip the demo shop, price list, and two sample jobs on boot.
SEED_DEMO=true


PORT=3000

# PayPal redirects here after checkout. Leave blank locally and Lou uses the
# request host. On Render, leave blank to use RENDER_EXTERNAL_URL, or set the
# public https URL if you use a custom domain. A public http URL is refused.
PUBLIC_BASE_URL=

# Where the JSON store lives. On Render's free tier the disk is ephemeral.
DATA_FILE=./data/lou.json

# OpenAI-compatible chat completions. Default is Google Gemini.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash

# PayPal REST. This demo refuses any host that is not sandbox.paypal.com
# unless PAYPAL_ALLOW_LIVE=true, which you should not set.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Sandbox client id (a public identifier, not the secret). From the PayPal
# Developer dashboard → Apps & Credentials → sandbox.
PAYPAL_CLIENT_ID=AS3g5d5XK4A0-FMYUVpU_-_M_mDJpHHP9vTG6AcWMPf2u0-a0QSd0vbNDtnvL-_tL8BWr5va91Xgn4uP
PAYPAL_CLIENT_SECRET=

# Optional. Lou POSTs the owner summary here when a call or text is saved.
# Leave blank and the summary stays on the shop board.
OWNER_WEBHOOK_URL=
OWNER_EMAIL=

# Twilio. Leave blank to simulate calls and texts on the shop board.
# Do not commit real values. Lou does not buy phone numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional PayPal webhook id. When set, Lou verifies webhook signatures.
# Payment status also updates on the checkout return URL and dashboard refresh
# without this.
PAYPAL_WEBHOOK_ID=
